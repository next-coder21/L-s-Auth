# ==============================================================================
# L's - Auth Configuration Template
# Commercial Identity Provider & Enterprise SSO Platform by Liji Groups
# ==============================================================================

# Database Settings (Local PostgreSQL)
# Product Database: liji_identity
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/liji_identity?schema=public"

# Keycloak Internal Database: liji_keycloak
KEYCLOAK_DB_NAME="liji_keycloak"
KEYCLOAK_DB_USERNAME="postgres"
KEYCLOAK_DB_PASSWORD="your_postgres_password"
KEYCLOAK_DB_HOST="localhost"
KEYCLOAK_DB_PORT="5432"

# Keycloak Identity Engine
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_ADMIN="admin"
KEYCLOAK_ADMIN_PASSWORD="your_secure_admin_password"
KEYCLOAK_DEV_REALM="liji-identity"

# Keycloak Admin Client Credentials (for NestJS Keycloak Admin service)
KEYCLOAK_ADMIN_CLIENT_ID="admin-cli"
KEYCLOAK_ADMIN_CLIENT_SECRET=""

# NestJS Management API
PORT=3001
API_URL="http://localhost:3001"
API_PREFIX="api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:4001,http://localhost:4002"

# Next.js Web Admin Portal
NEXT_PUBLIC_APP_NAME="L's - Auth"
NEXT_PUBLIC_PARENT_ORG="Liji Groups"
NEXT_PUBLIC_TAGLINE="One Identity. Every Application."
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_KEYCLOAK_URL="http://localhost:8080"
NEXT_PUBLIC_KEYCLOAK_REALM="liji-identity"
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID="ls-auth-web"

# Demo Applications
DEMO_APP_A_PORT=4001
DEMO_APP_B_PORT=4002
DEMO_CLIENT_A_ID="ls-demo-table"
DEMO_CLIENT_A_SECRET="demo-table-secret-replace-in-prod"
DEMO_CLIENT_B_ID="ls-demo-cars"
DEMO_CLIENT_B_SECRET="demo-cars-secret-replace-in-prod"

# SMTP / Email Notifications
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER="your-email@example.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="L's - Auth <no-reply@lijigroups.com>"

# Security & Sessions
SESSION_SECRET="super-secret-key-change-in-production-at-least-32-chars"
JWT_SECRET="jwt-signing-secret-for-internal-tokens"
